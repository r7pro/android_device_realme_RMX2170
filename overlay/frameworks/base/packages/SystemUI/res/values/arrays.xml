<resources>
    <!-- Array of brightness-alpha LUT for UDFPS framework dimming.
         Values match exact factory photometric calibration from panel DTS:
         arch/arm64/boot/dts/206B1/dsi-panel-oppo206B1samsung-ams643xy01-1080-2400-dsi-vid.dtsi (oppo,dsi-fod-brightness). -->
    <string-array name="config_udfpsDimmingBrightnessAlphaArray" translatable="false">
        <!-- AOD/Doze mode reports BRIGHTNESS_INVALID_FLOAT (-2.0f * 4095 = -8190).
             Matches interpolated factory DTS calibration for AOD backlight 258 (alpha 228)
             so AOD clock brightness remains identical before and during fp press. -->
        <item>-9999,228</item>
        <item>-8190,228</item>
        <!-- Factory panel DTS photometric calibration (oppo,dsi-fod-brightness) -->
        <item>0,255</item>
        <item>100,239</item>
        <item>190,235</item>
        <item>300,223</item>
        <item>415,214</item>
        <item>619,193</item>
        <item>823,170</item>
        <item>1027,147</item>
        <item>1231,128</item>
        <item>1435,105</item>
        <item>1639,87</item>
        <item>1748,69</item>
        <item>1843,64</item>
        <item>1950,52</item>
        <item>2047,40</item>
        <item>2560,32</item>
        <item>4095,0</item>
    </string-array>
</resources>
